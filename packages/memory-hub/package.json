{
  "name": "@universal-memory/hub",
  "version": "0.1.0",
  "description": "Universal MCP memory server — local + cloud, verifiable, multi-client",
  "type": "module",
  "bin": {
    "memory-hub": "src/mcp/server.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp/server.ts",
    "./storage": "./src/storage/index.ts",
    "./ingest": "./src/ingest/index.ts"
  },
  "dependencies": {
    "@mnemonik-xyz/sdk": "latest",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "gbrain": "workspace:../../vendors/gbrain",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/mcp/server.ts",
    "start": "bun src/mcp/server.ts",
    "test": "bun test src/",
    "setup": "bun run src/setup.ts",
    "typecheck": "tsc --noEmit"
  }
}
