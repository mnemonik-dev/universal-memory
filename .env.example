# Universal Memory System — Environment Variables
#
# Copy this file to .env and fill in required values:
#   cp .env.example .env
#   $EDITOR .env
#
# Docker Compose reads .env automatically.
# NEVER commit .env to git (it is in .gitignore).
#
# Required variables are marked with [REQUIRED].
# Optional variables are marked with [OPTIONAL] and include defaults.

# ─── Deployment mode ──────────────────────────────────────────────────────────
# [REQUIRED] Backend storage mode.
#   local — PGLite (WASM, no server), stdio MCP transport. Zero setup.
#   cloud — Postgres + pgvector, HTTP MCP transport (port 3456). Requires DATABASE_URL.
MEMORY_BACKEND=cloud

# ─── Postgres (cloud mode only) ───────────────────────────────────────────────
# [REQUIRED for cloud] Full Postgres DSN with pgvector.
# The docker-compose.yml memory-hub service assembles this from POSTGRES_* vars.
# Set DATABASE_URL if running memory-hub outside of Docker Compose.
DATABASE_URL=postgres://memory:changeme@localhost:5432/memory

# [REQUIRED for cloud] Postgres credentials — used by docker-compose.yml postgres service.
POSTGRES_USER=memory
POSTGRES_PASSWORD=changeme
POSTGRES_DB=memory

# ─── Bearer auth (cloud mode only) ────────────────────────────────────────────
# [REQUIRED for cloud] Static Bearer token for HTTPS API access.
# Generated with: openssl rand -hex 32
# Used by:
#   - nginx (primary auth gate, D4) in /etc/nginx/memory-secrets.conf
#   - memory-hub HTTP middleware (defense-in-depth, D10 timing-safe comparison)
MEMORY_API_KEY=changeme-generate-with-openssl-rand-hex-32

# ─── HTTP server ──────────────────────────────────────────────────────────────
# [OPTIONAL] Internal HTTP port for memory-hub. Default: 3456.
# Must match nginx proxy_pass target. Rarely needs changing.
MEMORY_HTTP_PORT=3456

# ─── LLM provider (for semantic search + synthesis) ───────────────────────────
# At least one key enables full semantic search + memory_think synthesis.
# Without any key, server starts in BM25-only mode (keyword search only).
# See tech-spec DEV-1 for BM25-only fallback details.
#
# Provider auto-detection priority (config.ts):
#   OPENAI_API_KEY → full mode (OpenAI embeddings + GPT synthesis)
#   ANTHROPIC_API_KEY → Anthropic Claude synthesis (no embedding — set OPENAI for embed)
#   GOOGLE_API_KEY → Google Gemini synthesis + embeddings
#   OLLAMA_BASE_URL → local Ollama embeddings + synthesis (no API key needed)
#   (none) → BM25-only mode

# [OPTIONAL] OpenAI API key — enables text-embedding-3-small + GPT synthesis.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [OPTIONAL] Anthropic API key — enables Claude synthesis (uses OpenAI for embedding).
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# [OPTIONAL] Google AI API key — enables Gemini synthesis + embeddings.
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# [OPTIONAL] Ollama base URL — enables local embeddings + synthesis (no cloud key needed).
# Run: ollama serve && ollama pull nomic-embed-text
# Default (if Ollama is running locally): http://localhost:11434
OLLAMA_BASE_URL=

# ─── Local mode (stdio) ───────────────────────────────────────────────────────
# [OPTIONAL] PGLite data directory. Default: ~/.universal-memory/brain
# Used only in local mode (MEMORY_BACKEND=local).
MEMORY_DATA_DIR=~/.universal-memory/brain

# ─── Mnemonik signing (cloud mode, optional) ──────────────────────────────────
# Enables memory_sign and memory_verify tools for Ed25519 attestation.
# Requires: npx @mnemonik-xyz/cli init && npx @mnemonik-xyz/cli login
# See: https://mnemonik.xyz/install

# [OPTIONAL] Enable Mnemonik signing tools. Default: false.
MNEMONIK_SIGNING=false

# [OPTIONAL] Ed25519 keypair JSON from `npx @mnemonik-xyz/cli init`.
# Contains private key — handle with care. D13: never logged.
# Format: {"type":"Ed25519","publicKey":"...","privateKey":"..."}
MNEMONIC_IDENTITY=

# [OPTIONAL] JWT from `npx @mnemonik-xyz/cli login`. Expires in 24h — re-run login to refresh.
# D13: startup log prints "(set)" but never the value.
MNEMONIC_JWT=

# [OPTIONAL] Mnemonik mode. Default: local (SQLite, free).
#   local       — local SQLite database, free, no external service
#   participate — Arweave + Solana anchoring, paid, for public verifiability
MNEMONIC_MODE=local

# ─── Ingestion security (D11) ─────────────────────────────────────────────────
# [OPTIONAL] Colon-separated list of directories allowed for file ingestion.
# Paths outside this list → error (path traversal defense).
# Default: /tmp (inside Docker container; adjust for your data volume mounts).
MEMORY_ALLOWED_DIRS=/tmp

# ─── nginx secrets (NOT in this file — kept separate) ────────────────────────
# Create /etc/nginx/memory-secrets.conf on the server with:
#   set $memory_api_key "YOUR_MEMORY_API_KEY_HERE";
# This file must NOT be committed. nginx/memory.conf includes it via `include`.
